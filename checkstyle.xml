<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- The platform's lint gate. Deliberately not google_checks/sun_checks: those
     are 90% formatting, so the first team to hit "line is 101 characters" turns
     the gate off and then nothing is linted. These rules are all defects a
     reviewer would ask you to fix anyway - swallowed exceptions, == on strings,
     a switch that falls through - so failing the build on them is defensible.

     Every service on the paved road inherits this file: new repos are created
     from this one, and the shared pipeline's `mvn -B verify` runs it in the
     validate phase, before compile. -->
<module name="Checker">
  <module name="TreeWalker">
    <!-- dead code -->
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>

    <!-- silent failure -->
    <module name="EmptyBlock">
      <property name="option" value="text"/>
    </module>
    <module name="EmptyCatchBlock"/>

    <!-- reads one way, behaves another -->
    <module name="NeedBraces"/>
    <module name="FallThrough"/>
    <module name="MissingSwitchDefault"/>
    <module name="DefaultComesLast"/>
    <module name="StringLiteralEquality"/>
    <module name="EqualsHashCode"/>
    <module name="OneStatementPerLine"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>

    <!-- easy to misread -->
    <module name="ModifierOrder"/>
    <module name="ArrayTypeStyle"/>
    <module name="UpperEll"/>
  </module>
</module>
